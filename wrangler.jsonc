{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veristat",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // Spec §8: upgrade to Workers Paid before first mainnet call; these limits
  // require the paid plan. subrequests capped as a runaway guard.
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "class_name": "VeristatMCP", "name": "VeristatMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VeristatMCP"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veristat",
      "database_id": "63379492-64ce-48a0-b39a-82aa54726dae"
    }
  ],
  "vars": {
    // base-sepolia for dev/testnet; set to "eip155:8453" (Base mainnet) for launch
    "NETWORK": "eip155:84532",
    // Facilitator abstraction (spec §3): x402.org for plain testnet payments.
    // Bazaar listing rehearsal + mainnet: https://api.cdp.coinbase.com/platform/v2/x402
    // (requires CDP_API_KEY_ID / CDP_API_KEY_SECRET secrets — docs/ROADMAP.md Phase 2).
    // Later: Cloudflare Monetization Gateway.
    "FACILITATOR_URL": "https://x402.org/facilitator",
    // Testnet receiver (.wallets/payto.key throwaway). Mainnet cutover: replace
    // with the operator's real Base USDC address (docs/ROADMAP.md Phase 3).
    "PAY_TO_ADDRESS": "0x86CdAe1A22458442BaB9E10216a7E96b606d3635",
    // Public /mcp URL — advertised as the 402 resource and catalogued by the
    // Bazaar on first CDP settlement (docs/research/bazaar-listing.md).
    // Set to the deployed workers.dev URL; empty disables discovery advertisement.
    "PUBLIC_URL": "https://veristat.grant-23a.workers.dev/mcp",
    "PANEL_MODEL_ANTHROPIC": "claude-sonnet-5",
    "PANEL_MODEL_OPENAI": "gpt-5-mini",
    "PANEL_MODEL_GOOGLE": "gemini-2.5-flash",
    "SYNTHESIS_MODEL": "claude-sonnet-5"
  }
  // Secrets (set via `npx wrangler secret put NAME`, or .dev.vars locally):
  //   ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY, QUOTE_SIGNING_KEY
  //   CDP_API_KEY_ID / CDP_API_KEY_SECRET — required once FACILITATOR_URL
  //   points at api.cdp.coinbase.com (src/payments/cdp.ts fails fast if missing)
}
